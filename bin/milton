#!/usr/bin/python3
#
#   bin/milton
#
import argparse
import logging
import os
import sys


#
#   path
#
DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(DIR, '..', 'src'))

# service dir[s]
for service in ['receiver', 'scraper', 'worker', 'dispatcher']:
    sys.path.insert(0, os.path.join(DIR, '..', 'src', service))


#
#   import[s]
#
from shared import util
from page import collect
from task import process


#
#   var[s]
#
EMAILS  = '/etc/milton/staples'
LABEL   = 'preview'
TIMEOUT = util.env_int('MILTON_SCRAPER_TIMEOUT', 30)


#
#   logging
#
util.log_setup()


#
#   command[s]
#
def scraper_scrape(args):

    # address[s]
    if args.address == None:
        addresses = util.emails(EMAILS)
    else:
        addresses = [args.address]

    # ok
    ok = True

    # address iterate
    for address in addresses:

        # address check
        if not util.valid(EMAILS, address):
            logging.warning(f"[{address}] not accepted")
            ok = False
            continue

        # log
        logging.info(f"[{address}] scrape")

        # collect
        if not collect(EMAILS, address, TIMEOUT):
            ok = False

    # return
    return ok

def worker_process(args):

    # address[s]
    if args.address == None:
        addresses = util.emails(EMAILS)
    else:
        addresses = [args.address]

    # ok
    ok = True

    # address iterate
    for address in addresses:

        # address check
        if not util.valid(EMAILS, address):
            logging.warning(f"[{address}] not accepted")
            ok = False
            continue

        # log
        logging.info(f"[{address}] [{LABEL}] process")

        # process guard
        try:
            process(EMAILS, address, LABEL, preserve_inbox = args.preserve_inbox)
        except Exception as error:
            logging.error(f"[{address}] [{LABEL}] failed[{error}]")
            ok = False

    # return
    return ok


#
#   parser
#
parser = argparse.ArgumentParser(
    prog        = 'milton',
    description = 'run milton service commands on demand'
)

# service[s]
service = parser.add_subparsers(dest = 'service', required = True)

# scraper
scraper = service.add_parser('scraper', help = 'site scraping commands')
scraper_command = scraper.add_subparsers(dest = 'command', required = True)

# scraper scrape
scraper_scrape_parser = scraper_command.add_parser(
    'scrape',
    help = 'fetch the sites of an address into xml/inbox, once per address'
)

scraper_scrape_parser.add_argument(
    'address',
    nargs   = '?',
    default = None,
    help    = 'address folder; every address when omitted'
)

scraper_scrape_parser.set_defaults(run = scraper_scrape)

# worker
worker = service.add_parser('worker', help = 'mail processing commands')
worker_command = worker.add_subparsers(dest = 'command', required = True)

# worker process
worker_process_parser = worker_command.add_parser(
    'process',
    help = 'run the prompt over the inbox for an address, once per address'
)

worker_process_parser.add_argument(
    'address',
    nargs   = '?',
    default = None,
    help    = 'address folder; every address when omitted'
)

worker_process_parser.add_argument(
    '--preserve-inbox',
    action = 'store_true',
    help   = 'leave the inbox in place instead of archiving it'
)

worker_process_parser.set_defaults(run = worker_process)


#
#   run
#
args = parser.parse_args()

# run
ok = args.run(args)

# ok check
if not ok:
    sys.exit(1)
